# Supabase Configuration
# Public project URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon/publishable key ONLY (never service_role)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server-Only Secret Key
# Server-only service_role key - DO NOT prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Admin Authentication
# Password for unlocking /admin (32+ random characters recommended)
ADMIN_ACCESS_PASSWORD=

# Secret key for HMAC token signing (32+ random characters recommended)
ADMIN_ACCESS_TOKEN_SECRET=
